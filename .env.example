# Configurações do Firebase para Solus Christus (Bíblia Sagrada)
# Obtenha estas credenciais gratuitamente no console do Firebase: https://console.firebase.google.com
# 1. Crie um projeto no Firebase (ex: "solus-christus-biblia")
# 2. Ative "Authentication" -> "Google"
# 3. Ative "Cloud Firestore Database"
# 4. Em Configurações do Projeto (ícone de engrenagem) -> Adicionar App Web (</>) e copie as chaves abaixo:

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
